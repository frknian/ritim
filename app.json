{
  "expo": {
    "name": "Ritim",
    "slug": "ritim",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#080B10",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.habbit.app",
      "adaptiveIcon": {
        "backgroundColor": "#080B10",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": true,
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "SCHEDULE_EXACT_ALARM",
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-sqlite",
      "expo-notifications",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "HabbitTodayWidget",
              "label": "Ritim: Günlük Alışkanlıklar",
              "description": "Günün alışkanlıklarını ana ekrandan takip edin ve tamamlayın",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "HabbitSummaryWidget",
              "label": "Ritim: Günlük İlerleme",
              "description": "Günün tamamlanma yüzdesi ve alışkanlık özet göstergesi",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "HabbitChainWidget",
              "label": "Ritim: Zinciri Kırma",
              "description": "Alışkanlık zincirini ve son günlerdeki durumunu gösterir",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ]
  }
}
